{
    "base_url": "http://127.0.0.1:5001/v1",
    "model": "local-model",
    "allow_remote": false,
    "system_prompt": "You are Iris, a friendly assistant. Keep spoken replies fairly short.",
    "temperature": 0.7,
    "max_tokens": 250,
    "history_turns": 12,
    "timeout": 120.0,
    "trace": false,
    "reply_encoding": "text",
    "stt_engine": "whisper",
    "whisper_model": "base.en",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "tokenizer_model": "jonatasgrosman/wav2vec2-large-xlsr-53-english",
    "ctc_model": "jonatasgrosman/wav2vec2-large-xlsr-53-english",
    "tts_engine": "kokoro",
    "kokoro_voice": "af_heart",
    "kokoro_speed": 1.0,
    "kokoro_model_dir": null,
    "phrase_time_limit": 30.0
}

{
    "base_url": "http://127.0.0.1:5001/v1",
    "model": "local-model",
    "allow_remote": false,
    "system_prompt": "You are Iris, a friendly assistant. Keep spoken replies fairly short.",
    "temperature": 0.7,
    "max_tokens": 250,
    "model_context_tokens": 8192,
    "context_margin_tokens": 512,
    "memory_summary_tokens": 1200,
    "memory_summary_interval": 8,
    "memory_summary_chars": 3000,
    "memory_retrieval_chars": 3000,
    "history_turns": 12,
    "memory_enabled": false,
    "memory_database": null,
    "memory_owner": "default",
    "memory_context_chars": 24000,
    "timeout": 120.0,
    "trace": false,
    "reply_encoding": "text",
    "tools_enabled": true,
    "chat_template_kwargs": {},
    "chat_request_options": {},
    "local_timezone": "Europe/London",
    "weather_enabled": false,
    "weather_location": "Stroud",
    "weather_country": "GB",
    "stt_engine": "whisper",
    "whisper_model": "base.en",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "tokenizer_model": "jonatasgrosman/wav2vec2-large-xlsr-53-english",
    "ctc_model": "jonatasgrosman/wav2vec2-large-xlsr-53-english",
    "tts_engine": "kokoro",
    "kokoro_voice": "af_heart",
    "kokoro_speed": 1.0,
    "kokoro_model_dir": null,
    "phrase_time_limit": 60.0
}
